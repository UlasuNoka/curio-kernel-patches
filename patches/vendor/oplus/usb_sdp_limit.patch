--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -596,4 +596,14 @@ source "drivers/misc/cardreader/Kconfig"
 source "drivers/misc/uacce/Kconfig"
 source "drivers/misc/pvpanic/Kconfig"
 source "drivers/misc/mchp_pci1xxxx/Kconfig"
+config USB_SDP_CURRENT_LIMIT
+	bool "Raise USB SDP input current limit to 900 mA on OPLUS devices"
+	depends on OF && PROC_FS
+	default y
+	help
+	  Updates OPLUS charger device-tree power tables at early_initcall time
+	  to allow up to 900 mA (4500 mW at 5 V) on USB Standard Downstream
+	  Ports (SDP) while preserving runtime toggle support via
+	  /proc/usb_sdp_limit.
+
 endmenu
