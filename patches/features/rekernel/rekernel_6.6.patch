diff --git a/drivers/misc/rekernel.c b/drivers/misc/rekernel.c
new file mode 100644
index 0000000..06c03e9
--- /dev/null
+++ b/drivers/misc/rekernel.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Re-Kernel Netlink event notifier for frozen background tasks.
+ */
+
+#define pr_fmt(fmt) "rekernel: " fmt
+
+#include <linux/cgroup.h>
+#include <linux/freezer.h>
+#include <linux/hash.h>
+#include <linux/init.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_ipv4.h>
+#include <linux/netfilter_ipv6.h>
+#include <linux/netlink.h>
+#include <linux/pid.h>
+#include <linux/pid_namespace.h>
+#include <linux/proc_fs.h>
+#include <linux/rekernel.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/spinlock.h>
+#include <linux/tcp.h>
+#include <net/net_namespace.h>
+#include <net/sock.h>
+
+#define NETLINK_REKERNEL_MAX		26
+#define NETLINK_REKERNEL_MIN		22
+#define REKERNEL_USER_PORT		100
+#define REKERNEL_MIN_APP_UID		10000
+#define REKERNEL_NF_RL_BITS		6
+#define REKERNEL_NF_RL_SLOTS		(1U << REKERNEL_NF_RL_BITS)
+#define REKERNEL_NF_RL_INTERVAL		(2 * HZ)
+#define REKERNEL_NO_LISTENER_BACKOFF	(5 * HZ)
+
+struct rekernel_nf_rl_slot {
+	uid_t uid;
+	unsigned long last_jiffies;
+	bool used;
+};
+
+static struct sock *rekernel_nl_sk;
+static int rekernel_netlink_unit;
+static unsigned long nl_backoff_until;
+
+static bool network_unfreeze;
+module_param(network_unfreeze, bool, 0644);
+MODULE_PARM_DESC(network_unfreeze,
+		 "Enable rate-limited TCP Netlink unfreeze notifications (default: false)");
+
+static DEFINE_SPINLOCK(nf_rl_lock);
+static struct rekernel_nf_rl_slot nf_rl_table[REKERNEL_NF_RL_SLOTS];
+
+static inline bool task_is_frozen_any(struct task_struct *p)
+{
+	struct task_struct *leader;
+
+	if (!p)
+		return false;
+	leader = p->group_leader ? p->group_leader : p;
+	return cgroup_task_frozen(leader) || frozen(leader) ||
+	       (READ_ONCE(leader->__state) & TASK_FROZEN);
+}
+
+/*
+ * Invoked from Binder, softirq, and hard-IRQ signal paths (do_send_sig_info);
+ * listener backoff state must remain lockless.
+ */
+static int rekernel_send_msg(const char *msg, size_t len)
+{
+	struct sk_buff *skb;
+	struct nlmsghdr *nlh;
+	int ret;
+
+	if (!rekernel_nl_sk)
+		return -ENODEV;
+
+	skb = nlmsg_new(len, GFP_ATOMIC);
+	if (!skb)
+		return -ENOMEM;
+
+	nlh = nlmsg_put(skb, 0, 0, NLMSG_DONE, len, 0);
+	if (!nlh) {
+		nlmsg_free(skb);
+		return -EMSGSIZE;
+	}
+
+	memcpy(nlmsg_data(nlh), msg, len);
+	ret = netlink_unicast(rekernel_nl_sk, skb, REKERNEL_USER_PORT,
+			      MSG_DONTWAIT);
+	if (ret == -ECONNREFUSED)
+		WRITE_ONCE(nl_backoff_until,
+			   jiffies + REKERNEL_NO_LISTENER_BACKOFF);
+	return ret;
+}
+
+void rekernel_report_binder_trans(int reply, bool oneway,
+				  struct task_struct *from,
+				  struct task_struct *target)
+{
+	char msg[128];
+	int len;
+
+	if (!rekernel_nl_sk || !from || !target)
+		return;
+	if (oneway || !task_is_frozen_any(target))
+		return;
+	if (task_uid(from).val == task_uid(target).val)
+		return;
+
+	len = snprintf(msg, sizeof(msg),
+		       "type=Binder,bindertype=%s,oneway=%d,from_pid=%d,from=%d,target_pid=%d,target=%d;",
+		       reply ? "reply" : "transaction", oneway ? 1 : 0,
+		       from->tgid, task_uid(from).val,
+		       target->tgid, task_uid(target).val);
+	if (len > 0 && len < sizeof(msg))
+		rekernel_send_msg(msg, len + 1);
+}
+
+void rekernel_report_binder_alloc(int target_pid, size_t size,
+				  size_t free_async_space,
+				  size_t buffer_size, int is_async)
+{
+	struct task_struct *target;
+	char msg[128];
+	uid_t from_uid, target_uid;
+	int len;
+
+	if (!rekernel_nl_sk || !is_async)
+		return;
+	if (free_async_space >= (buffer_size / 3) &&
+	    free_async_space >= 3 * (size + 64))
+		return;
+
+	rcu_read_lock();
+	/* binder_alloc.pid stores a global PID in init_pid_ns. */
+	target = pid_task(find_pid_ns(target_pid, &init_pid_ns), PIDTYPE_PID);
+	if (!target || !task_is_frozen_any(target)) {
+		rcu_read_unlock();
+		return;
+	}
+	from_uid = task_uid(current).val;
+	target_uid = task_uid(target).val;
+	rcu_read_unlock();
+
+	len = snprintf(msg, sizeof(msg),
+		       "type=Binder,bindertype=free_buffer_full,oneway=1,from_pid=%d,from=%d,target_pid=%d,target=%d;",
+		       current->tgid, from_uid, target_pid, target_uid);
+	if (len > 0 && len < sizeof(msg))
+		rekernel_send_msg(msg, len + 1);
+}
+
+void rekernel_report_signal(int sig, struct task_struct *killer,
+			    struct task_struct *dst)
+{
+	char msg[128];
+	int len;
+
+	if (!rekernel_nl_sk || !killer || !dst)
+		return;
+	if (sig != SIGKILL && sig != SIGTERM && sig != SIGABRT && sig != SIGQUIT)
+		return;
+	if (!task_is_frozen_any(dst))
+		return;
+
+	len = snprintf(msg, sizeof(msg),
+		       "type=Signal,signal=%d,killer_pid=%d,killer=%d,dst_pid=%d,dst=%d;",
+		       sig, killer->tgid, task_uid(killer).val,
+		       dst->tgid, task_uid(dst).val);
+	if (len > 0 && len < sizeof(msg))
+		rekernel_send_msg(msg, len + 1);
+}
+
+static bool rekernel_nf_allow(uid_t uid)
+{
+	unsigned long now = jiffies;
+	unsigned long until = READ_ONCE(nl_backoff_until);
+	struct rekernel_nf_rl_slot *slot;
+	bool allow = false;
+
+	if (until && time_before(now, until))
+		return false;
+
+	spin_lock_bh(&nf_rl_lock);
+	slot = &nf_rl_table[hash_32(uid, REKERNEL_NF_RL_BITS)];
+	if (!slot->used || slot->uid != uid ||
+	    time_after_eq(now, slot->last_jiffies + REKERNEL_NF_RL_INTERVAL)) {
+		slot->uid = uid;
+		slot->last_jiffies = now;
+		slot->used = true;
+		allow = true;
+	}
+	spin_unlock_bh(&nf_rl_lock);
+	return allow;
+}
+
+static unsigned int rekernel_nf_in(void *priv, struct sk_buff *skb,
+				   const struct nf_hook_state *state)
+{
+	struct sock *sk;
+	uid_t uid;
+	char msg[64];
+	int len;
+
+	if (!READ_ONCE(network_unfreeze) || !rekernel_nl_sk || !skb)
+		return NF_ACCEPT;
+
+	sk = skb_to_full_sk(skb);
+	if (!sk || !sk_fullsock(sk) || sk->sk_protocol != IPPROTO_TCP)
+		return NF_ACCEPT;
+
+	uid = sock_i_uid(sk).val;
+	if (uid < REKERNEL_MIN_APP_UID)
+		return NF_ACCEPT;
+
+	if (!rekernel_nf_allow(uid))
+		return NF_ACCEPT;
+
+	len = snprintf(msg, sizeof(msg), "type=Network,target=%d;", uid);
+	if (len > 0 && len < sizeof(msg))
+		rekernel_send_msg(msg, len + 1);
+
+	return NF_ACCEPT;
+}
+
+static const struct nf_hook_ops rekernel_nf_ops[] = {
+	{
+		.hook		= rekernel_nf_in,
+		.pf		= NFPROTO_IPV4,
+		.hooknum	= NF_INET_LOCAL_IN,
+		.priority	= NF_IP_PRI_SELINUX_LAST,
+	},
+#if IS_ENABLED(CONFIG_IPV6)
+	{
+		.hook		= rekernel_nf_in,
+		.pf		= NFPROTO_IPV6,
+		.hooknum	= NF_INET_LOCAL_IN,
+		.priority	= NF_IP6_PRI_SELINUX_LAST,
+	},
+#endif
+};
+
+static int rekernel_unit_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "%d\n", rekernel_netlink_unit);
+	return 0;
+}
+
+static int rekernel_unit_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, rekernel_unit_show, NULL);
+}
+
+static const struct proc_ops rekernel_proc_ops = {
+	.proc_open	= rekernel_unit_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static void rekernel_nl_rcv(struct sk_buff *skb)
+{
+}
+
+static int __init rekernel_init(void)
+{
+	struct netlink_kernel_cfg cfg = {
+		.input = rekernel_nl_rcv,
+	};
+	struct proc_dir_entry *dir;
+	char name[16];
+	int unit;
+
+	for (unit = NETLINK_REKERNEL_MAX; unit >= NETLINK_REKERNEL_MIN; unit--) {
+		rekernel_nl_sk = netlink_kernel_create(&init_net, unit, &cfg);
+		if (rekernel_nl_sk) {
+			rekernel_netlink_unit = unit;
+			break;
+		}
+	}
+
+	if (!rekernel_nl_sk) {
+		pr_err("failed to allocate netlink unit in [%d..%d]\n",
+		       NETLINK_REKERNEL_MIN, NETLINK_REKERNEL_MAX);
+		return -ENOMEM;
+	}
+
+	dir = proc_mkdir("rekernel", NULL);
+	if (dir) {
+		snprintf(name, sizeof(name), "%d", rekernel_netlink_unit);
+		proc_create(name, 0444, dir, &rekernel_proc_ops);
+	}
+
+	if (nf_register_net_hooks(&init_net, rekernel_nf_ops,
+				  ARRAY_SIZE(rekernel_nf_ops)))
+		pr_warn("failed to register netfilter hooks\n");
+
+	pr_info("initialized on netlink unit %d\n", rekernel_netlink_unit);
+	return 0;
+}
+late_initcall(rekernel_init);
+
+MODULE_DESCRIPTION("Re-Kernel Netlink event notifier for frozen tasks");
+MODULE_LICENSE("GPL");
