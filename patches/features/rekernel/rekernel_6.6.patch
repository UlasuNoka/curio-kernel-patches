@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_REKERNEL_H
+#define _LINUX_REKERNEL_H
+
+#include <linux/sched.h>
+#include <linux/types.h>
+
+#ifdef CONFIG_REKERNEL
+void rekernel_report_binder_trans(int reply, bool oneway,
+				  struct task_struct *from,
+				  struct task_struct *target);
+void rekernel_report_binder_alloc(int target_pid, size_t size,
+				  size_t free_async_space,
+				  size_t buffer_size, int is_async);
+void rekernel_report_signal(int sig, struct task_struct *killer,
+			    struct task_struct *dst);
+#else
+static inline void rekernel_report_binder_trans(int reply, bool oneway,
+						struct task_struct *from,
+						struct task_struct *target) {}
+static inline void rekernel_report_binder_alloc(int target_pid, size_t size,
+						size_t free_async_space,
+						size_t buffer_size,
+						int is_async) {}
+static inline void rekernel_report_signal(int sig, struct task_struct *killer,
+					  struct task_struct *dst) {}
+#endif
+
+#endif /* _LINUX_REKERNEL_H */
