 extern struct net init_net;
 
+/*
+ * Private SLUB tail after struct net to preserve KMI layout when
+ * CONFIG_NET_L3_MASTER_DEV is enabled.
+ */
+struct net_allocation {
+	struct net net;
+#ifdef CONFIG_NET_L3_MASTER_DEV
+	struct net_l3mdev_kabi l3mdev;
+#endif
+};
+
+#ifdef CONFIG_NET_L3_MASTER_DEV
+extern struct net_l3mdev_kabi init_net_l3mdev;
+
+static inline struct net_l3mdev_kabi *net_l3mdev(const struct net *net)
+{
+	if (net == &init_net)
+		return &init_net_l3mdev;
+	return &container_of((struct net *)net, struct net_allocation, net)->l3mdev;
+}
+#endif
+
